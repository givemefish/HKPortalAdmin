@using System.Globalization
@using System.Text.Json
@{
    var translations = L.GetAllStrings(includeParentCultures: true).ToDictionary(x => x.Name, x => x.Value);
    var config = new
    {
        culture = CultureInfo.CurrentUICulture.Name,
        urls = new {
            list = Url.Action("List"), categories = Url.Action("Categories"), get = Url.Action("Get"),
            defaults = Url.Action("Defaults"), save = Url.Action("Save"), batch = Url.Action("Batch"),
            download = Url.Action("Download"), image = Url.Action("UploadImage")
        },
        text = translations
    };
}
<div class="page-heading d-flex justify-content-between align-items-end mb-4">
    <div><div class="eyebrow">HK PORTAL / CONTENT</div><h1>@L["Articles"]</h1></div>
    <span class="connection-label">@L["ConnectionHint"]</span>
</div>
<div id="notice" role="status" aria-live="polite" class="alert d-none"></div>
<div id="kendoMissing" class="alert alert-warning">@L["KendoMissing"]</div>
<section class="card filter-card mb-4">
    <div class="card-body">
        <form id="searchForm" class="row g-3 align-items-end">
            <div class="col-lg-4"><label for="filterCategory" class="form-label">@L["Category"]</label><input id="filterCategory" class="w-100" /></div>
            <div class="col-lg-2"><label for="filterStatus" class="form-label">@L["Status"]</label><input id="filterStatus" class="w-100" /></div>
            <div class="col-lg-4"><label for="keyword" class="form-label">@L["Keyword"]</label><input id="keyword" class="form-control" maxlength="256" /></div>
            <div class="col-lg-2 d-flex gap-2"><button type="submit" class="btn btn-primary">@L["Search"]</button><button type="button" id="reset" class="btn btn-outline-secondary">@L["Reset"]</button></div>
        </form>
        <p class="form-text mb-0 mt-3">@L["CategoryHint"]</p>
    </div>
</section>
<section class="card list-card">
    <div class="card-header d-flex flex-wrap justify-content-between gap-3 align-items-center">
        <button id="newArticle" type="button" class="btn btn-primary">＋ @L["New"]</button>
        <div class="d-flex flex-wrap gap-2">
            <label class="visually-hidden" for="batchState">@L["Status"]</label><input id="batchState" />
            <button id="applyState" type="button" class="btn btn-outline-primary">@L["Apply"]</button>
            <button id="deleteArticles" type="button" class="btn btn-outline-danger">@L["Delete"]</button>
        </div>
    </div>
    <div id="articleGrid"></div>
</section>
<div id="articleWindow" style="display:none">
    <form id="articleForm">
        @Html.AntiForgeryToken()
        <div id="editorNotice" role="alert" class="alert d-none"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-12"><label for="editCategory" class="form-label">@L["Category"] *</label><input id="editCategory" class="w-100" /></div>
            <div class="col-md-6"><label for="beginDate" class="form-label">@L["Begin"] *</label><input id="beginDate" class="w-100" /></div>
            <div class="col-md-6"><label for="endDate" class="form-label">@L["End"] *</label><input id="endDate" class="w-100" /></div>
        </div>
        <div id="languageTabs">
            <ul><li class="k-active">@L["Traditional"]</li><li>@L["Simplified"]</li><li>@L["English"]</li></ul>
            @foreach (var lang in new[] { "ZHTW", "ZHCN", "EN" })
            {
                <div data-language="@lang">
                    <label for="subject@(lang)" class="form-label">@L["Subject"] @(lang == "ZHTW" ? "*" : "")</label>
                    <input id="subject@(lang)" class="form-control mb-3 subject-input" maxlength="256" />
                    <label for="body@(lang)" class="form-label">@L["Body"]</label>
                    <textarea id="body@(lang)"></textarea>
                    <div class="mt-3 image-controls">
                        <label class="btn btn-sm btn-outline-secondary upload-label">@L["UploadImage"]<input type="file" class="image-input" data-lang="@lang" accept=".jpg,.jpeg,.png,.gif,.webp" /></label>
                        <p class="form-text">@L["ImageHint"]</p>
                    </div>
                    <div class="attachment-section mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h6 mb-0">@L["Attachments"]</h2>
                            <label class="btn btn-sm btn-outline-primary attachment-controls upload-label">@L["AddAttachments"]<input type="file" class="attachment-input" data-lang="@lang" multiple /></label>
                        </div>
                        <p class="form-text attachment-controls">@L["FileHint"]</p>
                        <ul id="attachments@(lang)" class="list-group attachment-list"></ul>
                    </div>
                </div>
            }
        </div>
        <div class="editor-footer d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
            <small class="text-secondary save-hint">@L["SaveHint"]</small>
            <div class="d-flex gap-2"><button type="button" id="cancelEdit" class="btn btn-outline-secondary">@L["Cancel"]</button><button type="submit" id="saveArticle" class="btn btn-primary">@L["Save"]</button></div>
        </div>
    </form>
</div>
@section Scripts {
    <script id="portalConfig" type="application/json">@Html.Raw(JsonSerializer.Serialize(config))</script>
    <script src="~/js/articles.js" asp-append-version="true"></script>
}
